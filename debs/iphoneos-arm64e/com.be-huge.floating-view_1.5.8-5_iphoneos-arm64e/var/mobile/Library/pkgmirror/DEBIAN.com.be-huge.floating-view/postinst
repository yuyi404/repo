#!/bin/bash
# killall -9 mediaserverd

ROOT_PREFIX=""
ARCH=$(dpkg --print-architecture)
if [ "$ARCH" = "iphoneos-arm" ]; then
   if [ -L "/var/jb" ]; then
      # get symlink target
      # xina support
      destination=$(readlink -f /var/jb)
      if [ "$destination" != "/jb" ]; then
         ROOT_PREFIX="$destination"
      fi
   fi
else
   ROOT_PREFIX="/var/jb"
fi

mkdir -p $ROOT_PREFIX/var/mobile/Library/SplitViewProIcons
mkdir -p $ROOT_PREFIX/var/mobile/Library/SplitViewProSounds
mkdir -p $ROOT_PREFIX/var/mobile/Library/FloatingViewInfo
chmod 777 $ROOT_PREFIX/var/mobile/Library/SplitViewProIcons
chmod 777 $ROOT_PREFIX/var/mobile/Library/SplitViewProSounds
chmod 777 $ROOT_PREFIX/var/mobile/Library/FloatingViewInfo
